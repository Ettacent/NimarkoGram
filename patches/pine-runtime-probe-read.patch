+static bool TryReadMemoryWord(const void* base, size_t offset, uintptr_t& value) {
+    value = 0;
+    uintptr_t address = reinterpret_cast<uintptr_t>(base);
+#if defined(__aarch64__)
+    address &= UINT64_C(0x00ffffffffffffff);
+#endif
+    if (!address || offset > UINTPTR_MAX - address) return false;
+    address += offset;
+    if (address % alignof(void*) != 0 || address > UINTPTR_MAX - (sizeof(void*) - 1)
+            || address > static_cast<uint64_t>(std::numeric_limits<off64_t>::max()) - (sizeof(void*) - 1)) return false;
+
+    int saved_errno = errno;
+    int fd = open("/proc/self/mem", O_RDONLY | O_CLOEXEC);
+    uintptr_t word = 0;
+    ssize_t count = fd < 0 ? -1 : pread64(fd, &word, sizeof(word), static_cast<off64_t>(address));
+    if (fd >= 0) close(fd);
+    errno = saved_errno;
+    if (count != static_cast<ssize_t>(sizeof(word))) return false;
+    value = word;
+    return true;
+}
+
+static bool TryReadPointer(const void* base, size_t offset, void*& value) {
+    value = nullptr;
+    uintptr_t word;
+    if (!TryReadMemoryWord(base, offset, word) || !word || word % alignof(void*) != 0) return false;
+    value = reinterpret_cast<void*>(word);
+    return true;
+}

