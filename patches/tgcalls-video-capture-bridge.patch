+std::mutex captureSourceLeasesMutex;
+std::map<jlong, std::unique_ptr<CaptureSourceLease>> captureSourceLeases;
+jlong nextCaptureBindingId = 1;
+
+bool captureException(JNIEnv *env, const char *operation) {
+    if (!env->ExceptionCheck()) {
+        return false;
+    }
+    env->ExceptionClear();
+    RTC_LOG(LS_ERROR) << "Camera JNI failed: " << operation;
+    return true;
+}
+
+jmethodID captureMethod(JNIEnv *env, jclass cls, const char *name, const char *descriptor) {
+    const auto method = env->GetMethodID(cls, name, descriptor);
+    return captureException(env, name) ? nullptr : method;
+}
+
+jlong retainCaptureSource(rtc::scoped_refptr<webrtc::JavaVideoTrackSourceInterface> source,
+                          const std::shared_ptr<tgcalls::CaptureStateReporter> &reporter) {
+    auto lease = std::make_unique<CaptureSourceLease>();
+    lease->source = std::move(source);
+    lease->reporter = reporter;
+    lease->releaseThread = rtc::Thread::Current();
+    if (lease->releaseThread == nullptr) {
+        return 0;
+    }
+    std::lock_guard<std::mutex> lock(captureSourceLeasesMutex);
+    if (nextCaptureBindingId == std::numeric_limits<jlong>::max()) {
+        return 0;
+    }
+    const jlong id = nextCaptureBindingId++;
+    auto entry = captureSourceLeases.emplace(id, nullptr);
+    entry.first->second = std::move(lease);
+    return id;
+}
+
+void releaseCaptureSource(jlong id) {
+    std::unique_ptr<CaptureSourceLease> lease;
+    {
+        std::lock_guard<std::mutex> lock(captureSourceLeasesMutex);
+        auto entry = captureSourceLeases.find(id);
+        if (entry == captureSourceLeases.end()) {
+            return;
+        }
+        lease = std::move(entry->second);
+        captureSourceLeases.erase(entry);
+    }
+    auto *thread = lease->releaseThread;
+    thread->PostTask([lease = std::move(lease)] {
+        if (auto reporter = lease->reporter.lock()) reporter->retired();
+    });
+}
