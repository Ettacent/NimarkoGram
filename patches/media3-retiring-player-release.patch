+/* Copyright (C) 2026 Ettacent */
+
+/* Modifications Copyright (C) 2026 Ettacent */
+
+package androidx.media3.exoplayer;
+
+import android.graphics.SurfaceTexture;
+import android.os.Looper;
+import android.view.TextureView;
+import android.view.ViewGroup;
+import androidx.annotation.Nullable;
+import androidx.media3.common.util.UnstableApi;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.Set;
+
+@UnstableApi
+public final class RetiringPlayerRelease {
+  private static final int MAX_PENDING_RELEASES = 4;
+  private static final Set<ExoPlayerImpl> pending =
+      Collections.newSetFromMap(new IdentityHashMap<>());
+
+  private RetiringPlayerRelease() {}
+
+  public static boolean release(ExoPlayer player, @Nullable TextureView retiringView) {
+    if (Looper.myLooper() != Looper.getMainLooper()
+        || player.getApplicationLooper() != Looper.myLooper()) {
+      throw new IllegalStateException("Retiring player release requires the main application looper");
+    }
+    return player instanceof ExoPlayerImpl
+        && ((ExoPlayerImpl) player).releaseRetiringPlayer(retiringView);
+  }
+
+  static boolean tryRetain(ExoPlayerImpl player) {
+    if (pending.size() >= MAX_PENDING_RELEASES || pending.contains(player)) {
+      return false;
+    }
+    return pending.add(player);
+  }
+
+  static void complete(ExoPlayerImpl player) {
+    pending.remove(player);
+  }
+
+  static final class DetachedTexture implements TextureView.SurfaceTextureListener {
+    final SurfaceTexture surfaceTexture;
+    private boolean destroyed;
+
+    private DetachedTexture(SurfaceTexture surfaceTexture) {
+      this.surfaceTexture = surfaceTexture;
+    }
+
+    @Nullable
+    static DetachedTexture detach(
+        TextureView view, TextureView.SurfaceTextureListener owner) {
+      if (view.getSurfaceTextureListener() != owner
+          || !view.isAvailable()
+          || !(view.getParent() instanceof ViewGroup)) {
+        return null;
+      }
+      SurfaceTexture surfaceTexture = view.getSurfaceTexture();
+      if (surfaceTexture == null) {
+        return null;
+      }
+      DetachedTexture detached = new DetachedTexture(surfaceTexture);
+      view.setSurfaceTextureListener(detached);
+      try {
+        ((ViewGroup) view.getParent()).removeView(view);
+      } catch (RuntimeException e) {
+        if (!detached.destroyed) {
+          return null;
+        }
+      } finally {
+        if (view.getSurfaceTextureListener() == detached) {
+          view.setSurfaceTextureListener(detached.destroyed ? null : owner);
+        }
+      }
+      return detached.destroyed ? detached : null;
+    }
+
+    @Override
+    public boolean onSurfaceTextureDestroyed(SurfaceTexture surface) {
+      if (surface != surfaceTexture) {
+        return true;
+      }
+      destroyed = true;
+      return false;
+    }
+
+    @Override
+    public void onSurfaceTextureAvailable(SurfaceTexture surface, int width, int height) {}
+
+    @Override
+    public void onSurfaceTextureSizeChanged(SurfaceTexture surface, int width, int height) {}
+
+    @Override
+    public void onSurfaceTextureUpdated(SurfaceTexture surface) {}
+  }
+}
