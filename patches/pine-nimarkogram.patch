+    private static Object defaultResultFor(Member target) {
+        if (target instanceof Method) {
+            Class<?> ret = ((Method) target).getReturnType();
+            if (ret == boolean.class) return Boolean.FALSE;
+            if (ret == int.class) return 0;
+            if (ret == long.class) return 0L;
+            if (ret == short.class) return (short) 0;
+            if (ret == byte.class) return (byte) 0;
+            if (ret == char.class) return (char) 0;
+            if (ret == float.class) return 0f;
+            if (ret == double.class) return 0d;
+        }
+        return null;
+    }
+
     public static Object handleCall(HookRecord hookRecord, Object thisObject, Object[] args)
             throws Throwable {
         // WARNING: DO NOT print thisObject or args, else the toString() method will be called on it
@@ -753,6 +768,9 @@ public final class Pine {
                 callFrame.setResult(callFrame.invokeOriginalMethod());
             } catch (InvocationTargetException e) {
                 callFrame.setThrowable(e.getTargetException());
+            } catch (IllegalArgumentException e) {
+                Log.e(TAG, "Pine receiver/arg mis-read invoking original, skipping: " + hookRecord.target, e);
+                callFrame.setResult(defaultResultFor(hookRecord.target));
             }
         }
 
