+    if (UNLIKELY(javaOrigin == nullptr || javaBackup == nullptr)) {
+        JNIHelper::Throw(env, "java/lang/IllegalArgumentException",
+                "Pine.syncMethodInfo requires non-null origin and backup methods");
+        return;
+    }
     auto origin = art::ArtMethod::FromReflectedMethod(env, javaOrigin);
+    if (UNLIKELY(env->ExceptionCheck())) return;
+    if (UNLIKELY(origin == nullptr)) {
+        JNIHelper::Throw(env, "java/lang/IllegalArgumentException",
+                "Pine.syncMethodInfo could not resolve origin method");
+        return;
+    }
     auto backup = art::ArtMethod::FromReflectedMethod(env, javaBackup);
+    if (UNLIKELY(origin == nullptr || backup == nullptr || env->ExceptionCheck())) {
+        if (!env->ExceptionCheck()) {
+            JNIHelper::Throw(env, "java/lang/IllegalArgumentException",
+                    "Pine.syncMethodInfo could not resolve reflected methods");
+        }
+        return;
+    }
+
+    auto thread = art::Thread::Current(env);
+    if (UNLIKELY(env->ExceptionCheck())) return;
+    if (UNLIKELY(thread == nullptr)) {
+        JNIHelper::Throw(env, "java/lang/IllegalStateException", "Current ART thread is unavailable");
+        return;
+    }
+    ScopedDisableMovingGc guard(thread);

