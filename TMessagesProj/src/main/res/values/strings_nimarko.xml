    <!-- Message Filters (ported from NimarkoGram) -->
    <string name="NM_MF_Title">Message filtering</string>
    <string name="NM_MF_Subtitle">Hide unwanted messages by keyword</string>
    <string name="NM_MF_Miscellaneous">Miscellaneous</string>
    <string name="NM_MF_Filter">Enable filter</string>
    <string name="NM_MF_Filter_Desc">When the filter is enabled, selected words in incoming messages will automatically be hidden under a spoiler effect, making them unreadable until revealed.</string>
    <string name="NM_MF_Field">Enter words to filter</string>
    <string name="NM_MF_Field_Desc">Separate words with a comma, space, or line break. Use parentheses to group multiple words into a phrase. Case insensitive.
        \nExample: word, another, (multiple words here).
    </string>
    <string name="NM_MF_Translit">Translit detection</string>
    <string name="NM_MF_Translit_Desc">When enabled, the filter will also detect words written in transliteration (for example, \"test\" will be recognized as \"тест\").
        This helps to catch and hide messages under a spoiler even if Cyrillic letters are replaced with Latin ones. May slightly increase device CPU load.
    </string>
    <string name="NM_MF_Exact_Words">Exact word match</string>
    <string name="NM_MF_Exact_Words_Desc">When enabled, only words that fully match those in the filter list will be hidden.
        If a word appears in a different form (with prefixes, endings, or inside other words), it will not be hidden.
    </string>
    <string name="NM_MF_Exclusions">Exclusions</string>
    <string name="NM_MF_Entities">Link Entity Filter</string>
    <string name="NM_MF_EntitiesDesc">When enabled, this option extends filtering to links (entities) contained in messages. The system will scan the URLs for any of your configured filter keywords.
        If a match is found inside the link, the entire message will be automatically hidden under a spoiler, regardless of whether the keyword appears in the visible text or not.
        \n\nThis helps protect against disguised spam, hidden advertising, or phishing domains that could otherwise bypass regular text-based filtering.
    </string>
    <string name="NM_MF_HideAll">Entire message spoiler</string>
    <string name="NM_MF_HideAllDesc">Hides the entire message text and media under a spoiler if it contains a filtered word.</string>
    <string name="NM_MF_Collapse">Collapse messages</string>
    <string name="NM_MF_Collapse_Desc">When enabled, messages will automatically be collapsed. You can expand them by tapping on the message.</string>
    <string name="NM_MF_Transparent">Message Transparency</string>
    <string name="NM_MF_Transparent_Desc">Filtered messages become transparent so you can easily tell them apart.</string>
    <!-- Advanced (NG-extension): regex + per-chat overrides + rule chaining. -->
    <string name="NM_MF_Advanced">Advanced</string>
    <string name="NM_MF_UseRegex">Regex patterns</string>
    <string name="NM_MF_UseRegex_Desc">Treat the list below as Java regular expressions (case-insensitive). Useful for matching variations of a word, URLs, or numeric patterns.</string>
    <string name="NM_MF_RegexPatterns">Enter regex patterns</string>
    <string name="NM_MF_Regex_Desc">One pattern per line. Invalid patterns are skipped silently. Examples:\n  spam[a-z]*\n  https?://(bad|evil)\\.com\n  \\b\\d{4,}\\b</string>
    <string name="NM_MF_LogicMode">Rule chain</string>
    <string name="NM_MF_LogicOr">OR (any rule matches)</string>
    <string name="NM_MF_LogicAnd">AND (every rule type matches)</string>
    <string name="NM_MF_ChatWhitelist">Filter only in these chats</string>
    <string name="NM_MF_ChatBlacklist">Never filter in these chats</string>
    <string name="NM_FollowChannelInfo">Our channel :)</string>

