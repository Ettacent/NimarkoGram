uniform shader img;

uniform float2 resolution;
uniform float2 center;
uniform float2 size;
uniform float4 radius;
uniform float thickness;
uniform float refract_index;
uniform float refract_intensity;
uniform float reflection_enabled;
uniform float4 foreground_color_premultiplied;

float sdfRect(float2 p, float4 r) {
  r.xy = (p.x > 0.0) ? r.xy : r.zw;
  r.x  = (p.y > 0.0) ? r.x  : r.y;
  float2 q = abs(p) - size + r.x;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r.x;
}

half4 srcOver(half4 src, half4 dst) {
    half3 outRGB = (src.rgb + dst.rgb * (1.0 - src.a));
    float outA = src.a + (1.0 - src.a) * dst.a;
    return half4(outRGB, outA);
}

half4 main(in float2 fragCoord) {
  float2 p = fragCoord - center;
  float sd = sdfRect(p, radius);
  float2 uv = fragCoord;
  float rim = 0.0;
  if (sd < 0.0 && thickness > 0.0) {
    float2 gradient = float2(
        sdfRect(p + float2(0.5, 0.0), radius) - sdfRect(p - float2(0.5, 0.0), radius),
        sdfRect(p + float2(0.0, 0.5), radius) - sdfRect(p - float2(0.0, 0.5), radius));
    float2 normal = gradient / max(length(gradient), 0.001);
    float depth = min(thickness, min(size.x, size.y));
    float t = clamp(-sd / max(depth, 0.001), 0.0, 1.0);
    // Bounded lens with zero slope at both ends. The previous grazing-angle
    // refraction jumped tens of pixels at the silhouette. Full precision is
    // important here: half coordinates quantize while a panel is moving.
    float lens = 16.0 * t * t * (1.0 - t) * (1.0 - t);
    float strength = clamp((refract_index - 1.0) * 2.0, 0.0, 1.5)
        * clamp(refract_intensity, 0.0, 1.0);
    uv -= normal * depth * 0.85 * lens * strength;
    uv = clamp(uv, float2(0.5), max(resolution - float2(0.5), float2(0.5)));

    // Directional inner reflection, reusing the SDF gradient without another
    // backdrop sample. Its width scales with the existing glass thickness.
    float edge = 1.0 - smoothstep(0.0, max(1.0, thickness * 0.16), -sd);
    float light = clamp(0.5 - 0.35 * normal.x - 0.35 * normal.y, 0.0, 1.0);
    float shoulder = 1.0 - smoothstep(0.0, max(1.0, thickness * 0.65), -sd);
    rim = (edge * (0.04 + 0.12 * light) + shoulder * 0.065 * light)
        * clamp(refract_intensity, 0.0, 1.0) * reflection_enabled
        * smoothstep(0.0, 1.0, -sd);
  }

  half4 color = srcOver(half4(foreground_color_premultiplied), img.eval(uv));
  // Preserve coverage, including transparent corners and transition fades.
  color.rgb = mix(color.rgb, half3(color.a), rim);
  return color;
}
