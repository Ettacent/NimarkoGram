    <string name="NM_MF_Title">消息过滤</string>
    <string name="NM_MF_Subtitle">按关键词隐藏不想看的消息</string>
    <string name="NM_MF_Miscellaneous">更多</string>
    <string name="NM_MF_Filter">启用过滤器</string>
    <string name="NM_MF_Filter_Desc">启用过滤器后，收到消息中的选定词语会自动被隐藏在剧透效果下，在揭开前无法阅读。</string>
    <string name="NM_MF_Field">输入要过滤的词语</string>
    <string name="NM_MF_Field_Desc">用逗号、空格或换行分隔词语。用括号将多个词组合成词组。不区分大小写。
        \n示例：词语, 其他, (多个词组合)。
    </string>
    <string name="NM_MF_Translit">音译检测</string>
    <string name="NM_MF_Translit_Desc">启用后，过滤器还会检测以音译书写的词语（例如 \"test\" 会被识别为 \"тест\"）。
        这有助于在西里尔字母被替换为拉丁字母时也能捕捉并隐藏消息于剧透下。可能会略微增加设备 CPU 负载。
    </string>
    <string name="NM_MF_Exact_Words">精确匹配词语</string>
    <string name="NM_MF_Exact_Words_Desc">启用此选项后，只有与过滤列表中完全一致的词语才会被隐藏。
        如果词语以其他形式出现（带前缀、词尾或包含在其他词中），则不会被隐藏。
    </string>
    <string name="NM_MF_Exclusions">排除项</string>
    <string name="NM_MF_Entities">链接实体过滤</string>
    <string name="NM_MF_EntitiesDesc">启用后，此选项会将过滤扩展到消息中包含的链接（实体）。系统会扫描 URL 中是否含有你设定的任何过滤关键词。
        如果在链接中找到匹配项，无论关键词是否出现在可见文本中，整条消息都会自动被隐藏于剧透下。
        \n\n这有助于防范伪装的垃圾信息、隐藏的广告或钓鱼域名，它们本可绕过常规的文本过滤。
    </string>
    <string name="NM_MF_HideAll">整条消息剧透</string>
    <string name="NM_MF_HideAllDesc">如果消息含有被过滤的词语，则将整条消息的文本和媒体隐藏于剧透下。</string>
    <string name="NM_MF_Collapse">折叠消息</string>
    <string name="NM_MF_Collapse_Desc">启用后，消息将自动折叠。点击消息即可展开。</string>
    <string name="NM_MF_Transparent">消息透明度</string>
    <string name="NM_MF_Transparent_Desc">被过滤的消息会变得透明，方便你区分。</string>
    <string name="NM_MF_Advanced">高级（扩展）</string>
    <string name="NM_MF_UseRegex">正则表达式模式</string>
    <string name="NM_MF_UseRegex_Desc">将下方列表视为 Java 正则表达式（不区分大小写）。适用于匹配单词的不同写法、URL 或数字模式。</string>
    <string name="NM_MF_RegexPatterns">输入正则表达式</string>
    <string name="NM_MF_Regex_Desc">每行一个模式。无效模式会被静默跳过。示例：\n  spam[a-z]*\n  https?://(bad|evil)\\.com\n  \\b\\d{4,}\\b</string>
    <string name="NM_MF_LogicMode">规则链</string>
    <string name="NM_MF_LogicOr">或（任一规则匹配）</string>
    <string name="NM_MF_LogicAnd">与（所有规则类型都匹配）</string>
    <string name="NM_MF_ChatWhitelist">仅在这些聊天中过滤</string>
    <string name="NM_MF_ChatBlacklist">从不过滤这些聊天</string>
